# Copia este archivo como .env y rellena los valores. NUNCA subas el .env.

# API de pey (https://docs.pey.mx)
PEY_API_BASE_URL=https://api.pey.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=

# URL del pooler de Supabase en modo sesión. Sin ella, el servidor guarda en memoria
# y la salud dice "sin configurar". Nunca en el repositorio.
DATABASE_URL=

# Sesiones del negocio
SECRET_KEY=

# URL pública de la web (CORS). Varios orígenes separados por coma.
WEB_ORIGIN=http://localhost:5173

# Carpeta de la web que entrega el servidor (en la demo, ../web). Vacía: no entrega la web.
CARPETA_WEB=

# Límites de la demo pública (opcionales; estos son los valores por defecto)
MONTO_MAXIMO=100
EXPIRACION_SEGUNDOS=600
LIMITE_COBROS_POR_MINUTO=10

# IPs de los proxies de los que se acepta X-Forwarded-For.
PROXIES_CONFIABLES=127.0.0.1
# Segundos de escucha después de que vence el QR.
GRACIA_SEGUNDOS=600
# Canales de avisos abiertos a la vez por IP.
CANALES_POR_IP=10

# (Opcional) WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Plantilla de la configuración de la demo por el túnel (spec 003: QP-14, DP-36, DP-44, TK-4).
# Copia este archivo como backend/.env.demo en la computadora de la demo y rellena las llaves.
# NUNCA subas el backend/.env.demo: lleva la llave de pey y el secreto del aviso.
# Se arranca con: cd backend && uv run uvicorn app.main:app --env-file .env.demo --workers 1 --port 8000
# Cada variable va aquí aunque esté vacía: lo que falta se toma de backend/.env (desarrollo).

# API de pey: la llave de la demo y el secreto de su aviso, del portal de pey. Solo en la computadora de la demo.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=

# Dirección pública del túnel (Tailscale Funnel, DP-38). Es la de la Mac de Hugo; quien arme su propia
# demo pone aquí la de su túnel.
WEB_ORIGIN=https://pago-facil.tail8d44cb.ts.net

# Límites por IP de la demo (DP-36). Si la IP real no llega por el túnel, 60 (DP-40).
LIMITE_COBROS_POR_MINUTO=30
CANALES_POR_IP=30

# Vacía a propósito hasta el corte 2 (DP-44): sin esta línea, la demo tomaría la base de desarrollo de backend/.env.
# En F6 lleva la URL del pooler en modo sesión del proyecto de Supabase de la demo.
DATABASE_URL=
